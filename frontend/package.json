    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "dotenv": "^18.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-compiler": "npm:typescript@7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "5.4.3"
