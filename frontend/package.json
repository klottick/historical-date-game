{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-compiler/bin/tsc -p tsconfig.build.json && vite build",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc --noEmit -p tsconfig.json",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "lint:fix": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true ./",
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.ts",
    "preview": "vite preview",
    "generate-client": "openapi-ts"
  },
  "dependencies": {
