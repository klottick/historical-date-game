# Default-deny release build context. Development images use service contexts.
**
!Dockerfile
!.dockerignore
!LICENSE
!docker/
docker/**
!docker/python-build-constraints.txt
!backend/
backend/**
!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/app/
!backend/app/**
!backend/catalogue/
backend/catalogue/**
!backend/catalogue/README.md
!backend/catalogue/default.json
!backend/catalogue/releases/
backend/catalogue/releases/**
!backend/catalogue/releases/chronology-1276-runtime-v1/
!backend/catalogue/releases/chronology-1276-runtime-v1/**
!backend/catalogue/releases/chronology-1276-runtime-v2/
!backend/catalogue/releases/chronology-1276-runtime-v2/**
!backend/catalogue/media/
backend/catalogue/media/**
!backend/catalogue/media/chronology-1276-runtime-v1/
!backend/catalogue/media/chronology-1276-runtime-v1/*.svg
!backend/catalogue/media/chronology-1276-runtime-v2/
!backend/catalogue/media/chronology-1276-runtime-v2/*.svg
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
# Last-match protection, including files nested within allowlisted source.
**/.git
**/.git/**
**/.worktrees
**/.worktrees/**
**/.superpowers
**/.superpowers/**
**/.env
**/.env.*
**/.npmrc
