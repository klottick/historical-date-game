# Release assets pin this to the tested version@digest; do not use latest.
HDG_IMAGE=
HDG_BIND_ADDRESS=127.0.0.1
HDG_PORT=8000
PROJECT_NAME=Historical Date Game
# local permits ordinary HTTP guest cookies. HTTPS hosting uses production.
ENVIRONMENT=local
FRONTEND_HOST=http://localhost:8000
# Required permanent random secrets. Keep .env private and back it up securely.
# SECRET_KEY >=32 chars; POSTGRES_PASSWORD >=20; admin password >=12.
SECRET_KEY=
POSTGRES_USER=hdg
POSTGRES_PASSWORD=
POSTGRES_DB=hdg
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=
PUBLIC_REGISTRATION_ENABLED=true
# Optional mail configuration; no SMTP sidecar or credentials are bundled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=
SENTRY_DSN=
